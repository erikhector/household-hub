// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Accounts & households -------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  displayName     String
  createdAt       DateTime  @default(now())
  // Null = unverified. Set once by verifyEmailAction (src/lib/actions/auth.ts)
  // when a valid EmailVerificationToken is redeemed. A user's first-ever
  // successful sign-in is hard-gated on this being set — see
  // EmailNotVerifiedSignin in src/lib/auth.ts and loginAction in
  // src/lib/actions/auth.ts, which neither signupAction nor
  // joinViaInviteSignupAction (src/lib/actions/household.ts) sign a new
  // account into anymore. The dashboard banner
  // (src/components/dashboard/email-verification-banner.tsx) remains as a
  // soft nudge for any account that reached a session before this gate
  // existed — see EmailVerificationToken's doc comment below.
  emailVerifiedAt DateTime?
  // Set whenever the password changes (resetPasswordAction,
  // updatePasswordAction) and copied into the JWT at sign-in as
  // `pwdChangedAt` (src/lib/auth.config.ts). requireHousehold/requireUserId
  // (src/lib/session.ts) reject a session whose copy is older than this, so
  // a stolen session cookie stops working once the password is changed
  // (SCALE-H). Null = never changed since this column existed, and any
  // token is accepted — no forced logout for existing users on deploy.
  passwordChangedAt DateTime?

  // Account-level UI preferences, synced across every device the user signs
  // into (src/lib/preferences.ts). "dark"/"en" mirror the app's pre-existing
  // hardcoded defaults (src/app/layout.tsx's old defaultTheme, LOCALE_COOKIE's
  // defaultLocale) so existing users see no change until they pick otherwise.
  // Anonymous/pre-auth pages still fall back to the theme/locale cookies —
  // see getLocale() and RootLayout.
  theme              String @default("dark")
  locale             String @default("en")
  // { groupBy, category, location, status, updatedFilter } from
  // src/components/inventory/inventory-client.tsx — validated on read via
  // parseInventoryViewPrefs (src/components/inventory/inventory-table-utils.ts)
  // since this is user-controlled JSON, not schema-checked.
  inventoryViewPrefs Json?
  // GAP-27: opt-in weekly digest email (src/lib/weekly-digest.ts), toggled
  // from the Profile page and switched off again by the email's own
  // unsubscribe link. Off by default: email is a higher-commitment channel
  // than the in-app bell or push, so nobody starts receiving it without
  // asking for it.
  weeklyDigestEnabled Boolean @default(false)

  // GAP-7: the user's own Swish number, so household members who owe them
  // money get a "Pay with Swish" link on the Budget page's "Who owes whom"
  // card. Stored normalized as Swish's alias format (46 + number without
  // its leading 0, e.g. "46701234567" — see normalizeSwishNumber in
  // src/lib/swish.ts). Null = not set, and no link is shown. On User rather
  // than HouseholdMember because it's personal data the user edits once on
  // their Profile page, not a per-household setting — the same person in two
  // households gets paid on the same phone. Included in the profile data
  // export and deleted with the account.
  swishNumber String?

  memberships                HouseholdMember[]
  personalBudgetCategories   PersonalBudgetCategory[]
  personalTransactions       PersonalTransaction[]
  personalRecurringTemplates PersonalRecurringTemplate[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  pushSubscriptions          PushSubscription[]
  weeklyDigestSends          WeeklyDigestSend[]
}

// One row per subscribed browser/device (src/lib/actions/push.ts). Per-user
// rather than per-household — a subscription belongs to one browser, and a
// user can belong to multiple households (src/lib/session.ts's
// requireHousehold). sendPushToHousehold (src/lib/push.ts) fans out to every
// member's subscriptions when a notification fires.
model PushSubscription {
  id              String   @id @default(cuid())
  userId          String
  endpoint        String   @unique
  p256dh          String
  auth            String
  createdAt       DateTime @default(now())
  // GAP-14: per-browser quiet hours. sendPushToHousehold (src/lib/push.ts)
  // skips this subscription while the local hour in `timeZone` falls inside
  // [quietHoursStart, quietHoursEnd) — a window may wrap midnight (22 → 7).
  // Both hours null (or equal) means no quiet hours. Lives here rather than
  // on User because it's a per-device choice: silence the phone overnight
  // without silencing the laptop. Only the OS push is suppressed — the
  // Notification row and the in-app bell are unaffected.
  quietHoursStart Int?
  quietHoursEnd   Int?
  // IANA zone name from the browser's
  // Intl.DateTimeFormat().resolvedOptions().timeZone, refreshed on every
  // subscribe and quiet-hours save. The server runs in UTC, so without it
  // "22-7" would mean 22-7 UTC. Null/unrecognised = never treated as quiet.
  timeZone        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum HouseholdRole {
  OWNER
  CONTRIBUTOR
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  // AUTO-8: when an item crosses from in-stock into low/out of stock, drop
  // it onto the household's default shopping list automatically (see
  // addToDefaultListOnLowStock in src/lib/shopping/default-list.ts). On by
  // default — the whole point is that restocking stops depending on someone
  // remembering to press "Add low-stock items" — but a household-wide switch
  // on the Household page turns it off for anyone who'd rather curate by hand.
  autoAddLowStockToList Boolean @default(true)
  // AUTO-9: the order shopping mode walks category groups in. Two separate
  // columns rather than one table or one JSON blob: the learned map is
  // always read and rewritten whole (an EMA over every category a trip
  // touched, see src/lib/shopping/store-order.ts), and only ever on list
  // completion, so rows would buy nothing but N upserts; keeping the manual
  // order apart means a completion rewriting the learned map can never
  // clobber a hand-saved order being written at the same moment, and
  // "reset to learned" is just emptying the array.
  //   categoryOrderLearned: { [categoryKey]: position in 0..1 }, null until
  //     the first completed trip teaches it anything.
  //   categoryOrderManual: category keys in the order someone arranged them
  //     by hand via "Reorder sections"; empty = no manual order. Always
  //     beats the learned one.
  categoryOrderLearned  Json?
  categoryOrderManual   String[] @default([])

  // GAP-3: secret for the read-only iCalendar feed at
  // /api/calendar/[token] (meal plan + recurring bill due dates). Null means
  // the feed is off, which is the default: calendar apps can't send cookies,
  // so this token is the only credential and anyone holding the URL can read
  // the feed. Opt-in by the owner from the Household page
  // (enableCalendarFeedAction in src/lib/actions/household.ts); regenerating
  // replaces it, which is what makes an old leaked URL stop working. @unique
  // gives the route an indexed lookup, and Postgres allows many NULLs under a
  // unique index, so every household with the feed off can share the null.
  calendarFeedToken     String? @unique
  // GAP-13: ISO 4217 code (one of SUPPORTED_CURRENCIES in
  // src/lib/currency.ts, checked by setHouseholdCurrencyAction) that
  // on-screen amounts are *labelled* with. Display only: amounts are plain
  // Floats with no currency of their own and are never converted when this
  // changes, and receipt conversion still targets HOUSEHOLD_BASE_CURRENCY.
  // Null (the default) keeps the original symbol-free two-decimal display,
  // so existing households see no change until the owner picks one.
  currencyCode          String?
  // When ticking a shopping-list row updates inventory. ON_PUT_AWAY (the
  // default for new households) treats a tick as "in the cart" only — stock
  // moves when the row is confirmed via the list's "Put away" step
  // (putAwayItemsAction), so the pantry never claims milk that's still in
  // the trolley. ON_CHECK is the original behaviour, where the tick itself
  // is the arrival; the migration that added this column gave every
  // household that already existed ON_CHECK so nobody's habit changed under
  // them. Owner-editable from the Household page (setInventorySyncModeAction).
  inventorySyncMode     InventorySyncMode @default(ON_PUT_AWAY)
  // The expense category a completed shopping list (or a registered
  // receipt) logs its total to — see resolveShoppingExpenseCategory in
  // src/lib/budget-groceries-category.ts. Null until the first priced trip,
  // which find-or-creates "Groceries" and stores its id here, so renaming
  // that category afterwards (say to "Mat") keeps the link instead of a
  // fresh "Groceries" appearing next trip. Any member can point it at
  // another expense category from the Household page
  // (setShoppingExpenseCategoryAction). SetNull on delete falls back to the
  // "Groceries" default; the budget page won't delete a category that has
  // transactions anyway.
  shoppingExpenseCategoryId String?
  shoppingExpenseCategory   BudgetCategory? @relation("ShoppingExpenseCategory", fields: [shoppingExpenseCategoryId], references: [id], onDelete: SetNull)

  members            HouseholdMember[]
  invitations        Invitation[]
  inventoryItems     InventoryItem[]
  shoppingLists      ShoppingList[]
  listTemplates      ShoppingListTemplate[]
  recipes            Recipe[]
  itemAliases        ItemAlias[]
  mealPlans          MealPlan[]
  budgetCategories   BudgetCategory[]
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  memberSettlements  MemberSettlement[]
  notifications      Notification[]
  tasks              HouseholdTask[]
  notes              HouseholdNote[]
  weeklyDigestSends  WeeklyDigestSend[]
  duplicateDismissals InventoryDuplicateDismissal[]
  preparedBatches    PreparedBatch[]
}

// See Household.inventorySyncMode.
enum InventorySyncMode {
  ON_CHECK
  ON_PUT_AWAY
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(CONTRIBUTOR)
  createdAt   DateTime      @default(now())

  household               Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionSplits       TransactionSplit[]
  // Recurring-bill splitting (see RecurringTemplateSplit's doc comment
  // below) — mirrors transactionSplits above.
  recurringTemplateSplits RecurringTemplateSplit[]
  assignedTasks           HouseholdTask[]          @relation("TaskAssignedTo")
  completedTasks          HouseholdTask[]          @relation("TaskCompletedBy")
  authoredNotes           HouseholdNote[]
  settlementsPaid         MemberSettlement[]       @relation("SettlementFrom")
  settlementsReceived     MemberSettlement[]       @relation("SettlementTo")
  cookedBatches           PreparedBatch[]

  @@unique([householdId, userId])
}

model Invitation {
  id          String    @id @default(cuid())
  householdId String
  token       String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// Password-reset link, same token-based/time-limited shape as Invitation
// above. Unlike an invite link (an intentional, always-visible fallback for
// the inviting household owner), this token must only ever reach its owner
// via email — see requestPasswordResetAction/sendPasswordResetEmail in
// src/lib/actions/auth.ts / src/lib/email.ts. `expiresAt` is 1 hour from
// creation (vs. Invitation's 7 days): a reset link grants account takeover
// to whoever holds it, a much higher-value target than a household invite,
// and password-reset emails typically arrive within seconds — an hour is
// generous for a legitimate user while keeping a leaked/intercepted link's
// window small. `usedAt` marks it consumed (mirrors Invitation.acceptedAt);
// a fresh request invalidates a user's other outstanding unused tokens (see
// requestPasswordResetAction) so an old leaked link stops working.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email-verification link, same token-based/time-limited shape as
// PasswordResetToken above — see signupAction/sendVerificationEmail/
// verifyEmailAction/resendVerificationEmailAction in
// src/lib/actions/auth.ts / src/lib/email.ts. `expiresAt` is 36 hours from
// creation: shorter than Invitation's 7 days (an unverified signup
// shouldn't linger indefinitely, and a stale token is worthless anyway once
// resent), but well past PasswordResetToken's 1 hour, since holding this
// token grants no account access or takeover — the worst it can do is mark
// an email verified, which the legitimate owner wanted anyway. 36 hours
// covers a full day-plus for someone who signs up before bed and checks
// email the next morning, without leaving months-old links live. `usedAt`
// marks it consumed (mirrors PasswordResetToken.usedAt); both a fresh
// signup-time send and a resend request invalidate a user's other
// outstanding unused tokens (see resendVerificationEmailAction) so old
// leaked/stale links stop working.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Inventory & shopping ---------------------------------------------------

model InventoryItem {
  id                 String    @id @default(cuid())
  householdId        String
  name               String
  category           String
  quantity           Float     @default(0)
  unit               String    @default("pcs")
  lowStockThreshold  Float     @default(1)
  location           String?
  lastKnownPrice     Float?
  // Optional best-before/expiry date. Historically set only from the
  // single-item add/edit form (ItemFormDialog) — AUTO-7 supersedes that for
  // *estimated* dates only: a stock-arrival action (togglePurchasedAction,
  // applyReceiptScanAction/registerReceiptAction, bulkCreateInventoryItemsAction)
  // can now fill this in from the item's shelf life, with
  // `expiresAtEstimated` set alongside it. A date typed into the item form
  // is always real (`expiresAtEstimated: false`) and is never overwritten by
  // the estimator — see src/lib/inventory/shelf-life.ts's
  // `estimatedExpiryUpdate`, the shared gate every arrival path calls
  // through.
  expiresAt          DateTime?
  // True when `expiresAt` was filled in by the shelf-life estimator rather
  // than typed by a user — ExpiryBadge shows a "≈" prefix and a softer
  // style for these, and EXPIRING_SOON notifications soften their copy
  // ("probably"). Saving the item form always clears this back to false,
  // since typing/confirming a date in that form makes it real (see
  // ItemFormDialog).
  expiresAtEstimated Boolean   @default(false)
  // Per-item override for the estimator's shelf life, in days from the
  // moment stock arrives. `null` (the default) means "use the category
  // default" (see AUTO_CATEGORY_KEYS's defaults in shelf-life.ts); `-1`
  // means "this item never expires" (Grocy's convention) and permanently
  // opts it out of estimation — the item form's "doesn't expire" checkbox
  // sets this. A positive value is a per-item override the estimator uses
  // instead of the category default.
  shelfLifeDays      Int?
  // GAP-28 — Grocy's separate "use within N days once opened" clock (milk
  // keeps ~14 days sealed but only ~3 once opened). `useWithinDaysOpened` is
  // an optional positive per-item setting from the item form; the inventory
  // row only offers "Mark opened" when it's set, since without it there's
  // nothing to recompute. `openedAt` is when that click happened — it pulls
  // `expiresAt` in to min(expiresAt, openedAt + useWithinDaysOpened) (see
  // openedExpiryUpdate in src/lib/inventory/expiry.ts for the rule and why
  // a winning opened date is flagged `expiresAtEstimated`), and is cleared
  // again when the item is restocked from zero, since a fresh pack is sealed
  // (see openedResetOnArrival, same file).
  openedAt           DateTime?
  useWithinDaysOpened Int?
  // GAP-44 — "Freeze it": the mirror image of the opened clock for the most
  // common way a household avoids waste. `frozenAt` is when the row's
  // "Freeze" button was clicked; it replaces `expiresAt` with frozenAt +
  // `useWithinDaysFrozen` days (null = the 90-day default, see
  // DEFAULT_USE_WITHIN_DAYS_FROZEN and frozenExpiryUpdate in
  // src/lib/inventory/expiry.ts) and is cleared when the item is restocked
  // from zero, since a new pack arrives thawed (see frozenResetOnArrival).
  frozenAt            DateTime?
  useWithinDaysFrozen Int?
  // AUTO-10: the "You usually buy this about now" chip is dismissed until
  // this moment. Dismissing sets it one median purchase interval ahead —
  // the item's next cycle (repurchaseSnoozeUntil in
  // src/lib/inventory/repurchase-calc.ts); null = never dismissed, a past
  // value = expired. Stored on the item rather than in the browser so a
  // dismissal holds on every member's device, and household-scoped for
  // free through the item's householdId.
  repurchaseSnoozedUntil DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Who last touched this row — set on every mutation (edits, quantity
  // +/- taps, mark-empty, bulk field edits) by src/app/dashboard/inventory/
  // actions.ts, mirroring Transaction.createdByUserId's plain-string
  // (no @relation) shape: resolved to a display name via a household-member
  // lookup in the inventory page rather than a Prisma join. Surfaced next to
  // `updatedAt` in the inventory table/detail view so a household can spot
  // items that haven't been touched (and recounted) in a while.
  updatedByUserId    String?
  // The retail barcode (EAN/UPC digits, normalized by normalizeBarcode in
  // src/lib/barcode.ts) this household links to the item — set by a stock
  // scan's "Add as new item"/"This is…" (AUTO-6), the add-item form's scan
  // button or the scan-multiple queue, so the next scan of the same code
  // resolves straight to this row. Unique per household (see @@unique
  // below): one product per code, and linking a code to a second item
  // moves it rather than sharing it. Never sent anywhere — only the scanned
  // digits of an *unknown* code go to Open Food Facts.
  barcode            String?

  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  shoppingListItems ShoppingListItem[]
  listTemplateItems ShoppingListTemplateItem[]
  priceHistory      PriceHistory[]
  recipeIngredients RecipeIngredient[]
  aliases           ItemAlias[]
  unitConversions   ItemUnitConversion[]
  notifications     Notification[]
  // MATCH-7: "Not duplicates" answers this item is part of, on either side.
  dismissalsAsA     InventoryDuplicateDismissal[] @relation("DismissalItemA")
  dismissalsAsB     InventoryDuplicateDismissal[] @relation("DismissalItemB")

  @@index([householdId])
  // The "expiring soon" notification sync (syncExpiringSoonNotifications in
  // src/lib/notifications.ts) filters by householdId and expiresAt — this
  // composite index serves that access pattern directly.
  @@index([householdId, expiresAt])
  // Also the lookup index for scanStockChangeAction's household-scoped
  // barcode resolve. Postgres treats NULLs as distinct, so any number of
  // items can have no barcode.
  @@unique([householdId, barcode])
}

enum NotificationKind {
  OUT_OF_STOCK
  MEAL_NOT_LOGGED
  EXPIRING_SOON
  // Retired (see src/lib/notifications.ts's top doc comment) — nothing
  // creates these anymore; kept only so any pre-existing rows still
  // deserialize. getActiveNotifications drops them rather than showing them.
  RESTOCKED
  // Good news (see docs/archive/JOY_GAP_BACKLOG.md item 4) — the bell gives this a
  // distinct treatment from the warning kinds. Same lifecycle as every
  // other kind (fired once at the transition, cleared only by dismissal).
  LIST_CLEARED
  // GAP-9: a newly recorded PriceHistory price materially above that item's
  // trailing median — see recordPriceSpikes in src/lib/notifications.ts.
  PRICE_SPIKE
  // Ticked shopping-list rows that were never put away, a few hours after
  // the trip — see syncPutAwayReminders in src/lib/notifications.ts.
  PUT_AWAY_REMINDER
}

// Persisted household alerts (see src/lib/notifications.ts) — replaces an
// earlier design with no table at all, where every alert was recomputed
// live on each render. Four triggers, all fired at the moment they happen
// rather than recomputed:
// - OUT_OF_STOCK: an existing InventoryItem's quantity crossing from > 0
//   into <= 0. Never fired for items created at zero (recipe-ingredient
//   auto-create, the add-item dialog, starter kits, quick-add) — those are
//   new items, not a depletion event. See recordOutOfStockTransition.
// - MEAL_NOT_LOGGED: a past MealPlanEntry found with `consumedAt` still
//   null. Fired lazily (no background job) the first time
//   getActiveNotifications runs after that becomes true. The @@unique on
//   mealPlanEntryId makes this fire at most once per entry, ever —
//   dismissing it (or ignoring it) never brings it back.
// - EXPIRING_SOON: an InventoryItem with `expiresAt` set, still in stock,
//   within EXPIRY_WARNING_DAYS of its expiry date (or already past it).
//   Fired lazily the same way MEAL_NOT_LOGGED is, but deduped like
//   OUT_OF_STOCK (an application-level check for an existing undismissed
//   alert for the same item, not a DB unique constraint) since an item can
//   legitimately be re-stocked with a new expiry date after the old alert
//   was dismissed. See syncExpiringSoonNotifications.
// - LIST_CLEARED (good news): a ShoppingList's unpurchased item count
//   crossing from >0 to 0 — every item got checked off or removed. Fired at
//   most once per crossing (checking/removing another item while already
//   at 0 is a no-op), and can fire again the next time the list refills and
//   clears again. See recordListClearedTransition.
// - PRICE_SPIKE (GAP-9): a newly recorded PriceHistory price (checking an
//   item off with a price, a receipt scan/register) that's materially above
//   that item's trailing median per unit — see detectPriceSpike
//   (src/lib/price-spike.ts) for what "materially" means. Deduped per item
//   against any undismissed alert *and* any alert created in the last
//   PRICE_SPIKE_COOLDOWN_DAYS, dismissed or not, so re-checking the same
//   purchase doesn't re-alert. `priceIncreasePercent` is set only on these
//   rows, so the bell can say "cost N% more than usual" without re-deriving
//   the median on every read.
// RESTOCKED (the inverse of OUT_OF_STOCK — an item crossing back above its
// low-stock threshold) used to be a fifth trigger; it's retired by product
// decision (see src/lib/notifications.ts) and no longer fires.
// `dismissedAt` is set the moment a user clicks the notification (see
// dismissNotificationAction) — dismissed rows are kept, not deleted, so
// MEAL_NOT_LOGGED's once-ever guarantee holds, and are simply excluded from
// what the bell displays. Unlike the old live-computed model, a
// notification does NOT clear itself when the underlying condition
// resolves — e.g. an OUT_OF_STOCK alert doesn't disappear just because the
// item is later restocked; dismissal is the only way to clear any alert.
//
// Every trigger fired from a specific user action (as opposed to the lazy
// background syncs above, which have no single actor) also excludes that
// user from the resulting push notification — see sendPushToHousehold in
// src/lib/push.ts. The person who just did the thing doesn't need to be
// told they did it; their other household members still get pushed.
model Notification {
  id              String           @id @default(cuid())
  householdId     String
  kind            NotificationKind
  inventoryItemId String?
  mealPlanEntryId String?
  shoppingListId  String?
  // PRICE_SPIKE only (GAP-9): how far above the trailing median the new
  // price was, as a rounded percentage. Null on every other kind.
  priceIncreasePercent Int?
  createdAt       DateTime         @default(now())
  dismissedAt     DateTime?

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  mealPlanEntry MealPlanEntry? @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)
  shoppingList  ShoppingList?  @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@unique([mealPlanEntryId])
  @@index([householdId, dismissedAt])
  @@index([inventoryItemId])
  @@index([shoppingListId])
}

enum ShoppingListStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model ShoppingList {
  id          String             @id @default(cuid())
  householdId String
  name        String
  status      ShoppingListStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  completedAt DateTime?
  archivedAt  DateTime?
  // AUTO-8: the household's always-on "Next shop" list, the one low-stock
  // items auto-add to and markItemEmptyAction targets. At most one ACTIVE
  // default per household — enforced by getOrCreateDefaultShoppingList
  // (src/lib/shopping/default-list.ts) and backed by a partial unique index
  // written by hand in this field's migration (Prisma's schema language
  // can't express a `WHERE` on an index). Cleared whenever the list leaves
  // ACTIVE (complete/archive) so un-archiving an old default can never
  // produce a second one.
  isDefault   Boolean            @default(false)
  // When the "Put away your shopping?" reminder last went out for this list
  // (syncPutAwayReminders in src/lib/notifications.ts). A ticked row that
  // was checked off after this moment belongs to a newer trip and can earn
  // a new reminder; one checked off before it already had its nudge. Kept
  // on the list rather than per row because the reminder is per trip, and
  // the default list lives across many trips.
  putAwayRemindedAt DateTime?

  household     Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items         ShoppingListItem[]
  shareLinks    ShoppingListShareLink[]
  notifications Notification[]

  @@index([householdId])
}

// A publicly-reachable, token-only link that grants view + check-off access
// to one ShoppingList with no login at all — see
// src/app/share/shopping-list/[token]/page.tsx and
// src/app/share/shopping-list/actions.ts. Deliberately shaped like
// Invitation above but WITHOUT an `expiresAt`: per product decision, this
// link never expires on its own and is only ever closed by a household
// member calling revokeShareLinkAction (src/app/dashboard/shopping-list/
// share-actions.ts), which sets `revokedAt`. `revokedAt: null` means active.
// A ShoppingList can have more than one row here over its lifetime (each
// revoke-then-reshare creates a fresh token rather than reusing/clearing the
// old one), but createShareLinkAction reuses an existing active link instead
// of piling up duplicates for the common case.
model ShoppingListShareLink {
  id             String    @id @default(cuid())
  shoppingListId String
  token          String    @unique
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

model ShoppingListItem {
  id                 String   @id @default(cuid())
  shoppingListId     String
  inventoryItemId    String?
  name               String
  quantity           Float    @default(1)
  unit               String   @default("pcs")
  estimatedPrice     Float?
  // GAP-5: optional free-text note on a line ("get the ripe ones", "any
  // brand is fine"). Set from the row's edit dialog after the item is
  // added, never asked for at add time, so the smart add line stays one
  // quick type-and-enter. null (never "") when there's no note.
  note               String?
  purchased          Boolean  @default(false)
  // AUTO-9: when someone ticked this row off by hand (togglePurchasedAction
  // or the share-link toggle), cleared again when it's un-ticked. It's the
  // only record of a trip's check-off sequence: completing the list reads
  // these to learn the household's store order, so an un-tick never leaves
  // a stale step behind. Deliberately not set by receipt apply, which marks
  // a whole receipt purchased at one instant and so says nothing about the
  // order anyone walked the aisles in. null on every row checked off before
  // this column existed.
  checkedOffAt       DateTime?
  // Who ticked the row (togglePurchasedAction), so the put-away reminder
  // goes to the person carrying the bags rather than the whole household.
  // Plain string (no @relation), mirroring Transaction.createdByUserId: a
  // member leaving mustn't take list history with them. null for share-link
  // ticks (no account) and rows ticked before this column existed — the
  // reminder then goes to the whole household.
  checkedOffByUserId String?
  // When this row's stock actually landed in inventory: the put-away step
  // (putAwayItemsAction), or the tick itself for an ON_CHECK household, or
  // "Register receipt" (already home). A row that's `purchased` with this
  // still null is *incoming* — in the cart or the bags, not yet in the
  // pantry (see src/lib/incoming-stock.ts). Cleared again whenever the row
  // is un-ticked, since that reverses the arrival too. The migration that
  // added it backfilled every already-purchased row, since those had
  // already been counted into inventory by the old tick.
  putAwayAt          DateTime?
  // When this line's price was written to PriceHistory, if it has been.
  // Only the put-away step reads it: a receipt applied while the row is
  // still in the cart records the real price (and the store, GAP-6) at that
  // moment, and the later put-away must not record the same purchase a
  // second time.
  priceRecordedAt    DateTime?
  addedAutomatically Boolean  @default(false)
  createdAt          DateTime @default(now())

  shoppingList  ShoppingList   @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([shoppingListId])
  @@index([inventoryItemId])
}

// GAP-4: a reusable, named snapshot of a list's items ("BBQ", "Costco
// run") that a household can stamp out as a fresh ACTIVE list whenever it
// needs one. Deliberately separate from AUTO-8's isDefault list, which fills
// itself from low stock — a template never changes on its own. Saved from a
// list's ⋯ menu (saveAsTemplateAction) and used from the overview page
// (createListFromTemplateAction), both in
// src/app/dashboard/shopping-list/template-actions.ts. Names are unique per
// household so the picker never shows two identical rows, and saving under
// an existing name is refused rather than silently overwriting.
model ShoppingListTemplate {
  id          String   @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime @default(now())

  household Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingListTemplateItem[]

  @@unique([householdId, name])
}

// One line of a ShoppingListTemplate. Only what a new list needs to
// recreate the line — name, quantity, unit — plus the inventory link it had
// when saved. The link is a hint, not a promise: it's SetNull when that
// InventoryItem is deleted, and createListFromTemplateAction re-resolves any
// unlinked line by name exactly the way importShoppingListItemsAction does.
// Prices and notes are intentionally not copied: a price goes stale between
// uses (the new list picks up lastKnownPrice instead) and a note is usually
// about that one trip.
model ShoppingListTemplateItem {
  id              String  @id @default(cuid())
  templateId      String
  inventoryItemId String?
  name            String
  quantity        Float   @default(1)
  unit            String  @default("pcs")
  // Keeps the list's order when the template is expanded again.
  position        Int     @default(0)

  template      ShoppingListTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?       @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([inventoryItemId])
}

model PriceHistory {
  id              String   @id @default(cuid())
  inventoryItemId String
  // The price paid for the whole purchased line, not one unit of it — a
  // shopping-list item's estimatedPrice / a receipt line's price, for
  // however much of the item that line bought (see recipe-cost.ts).
  price           Float
  // GAP-9: that line's quantity and unit, so prices can be compared
  // like-for-like per unit (2 × milk at 30 is not a price jump over 1 × milk
  // at 15). Null on rows written before GAP-9, which detectPriceSpike
  // (src/lib/price-spike.ts) therefore can't compare against.
  quantity        Float?
  unit            String?
  store           String?
  date            DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
}

// --- Meal planning -----------------------------------------------------------

model Recipe {
  id                     String   @id @default(cuid())
  householdId            String
  name                   String
  instructions           String?
  // How many portions the ingredient quantities on this recipe (as entered)
  // actually make. MealPlanEntry.portions is scaled against this — see its
  // doc comment below — so ingredient totals for a meal-plan entry reflect
  // how many portions that specific slot is cooking, not always "one full
  // recipe." Defaults to 4 (a common household recipe size) both here and
  // on MealPlanEntry.portions so pre-existing rows keep a 1:1 ratio — i.e.
  // no behavior change — until a household actively edits either value.
  servings               Int      @default(4)
  createdAt              DateTime @default(now())
  // Optional, manual-entry-only nutrition info — never fetched from an
  // external nutrition-lookup API (that's a separate, larger effort needing
  // its own SSRF-safe-fetch review, same as the recipe-URL-import feature
  // above). All four are per-serving (not raw recipe totals) since
  // `servings` already exists and per-serving figures are what's actually
  // useful on a recipe card. Null on every field means "not entered" —
  // RecipeManager only renders a nutrition line when at least one is set.
  caloriesPerServing     Int?
  proteinGramsPerServing Float?
  carbsGramsPerServing   Float?
  fatGramsPerServing     Float?
  // Household-wide "we actually like this one" flag (BACKLOG GAP-18) — a
  // plain boolean rather than a per-member rating, the same minimal-first
  // call HouseholdTask v1 made for assignment. Only ever a *tiebreaker* in
  // the Cook tab's and "use it up" suggestion ranking (see
  // computeCookableRecipes / computeUseItUpSuggestions), never a filter, so
  // starring a recipe can't hide an un-starred one that's a better match.
  isFavorite             Boolean  @default(false)
  // Dietary/"quick" tags (GAP-29) — keys from the CLOSED set in
  // src/lib/recipe-tags.ts (RECIPE_TAGS), labelled per locale from
  // `mealPlanning.recipeTags`. A plain text[] rather than a Postgres enum or
  // a join table: the set is tiny, only ever filtered client-side over the
  // household's already-loaded recipe list, and growing it shouldn't need a
  // migration. The closed set is enforced in application code instead —
  // every write goes through parseRecipeTags, and so does every read, so a
  // key later removed from the set is silently ignored rather than shown.
  tags                   String[] @default([])

  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredients     RecipeIngredient[]
  mealPlanEntries MealPlanEntry[]
  // Sub-recipes this recipe includes (e.g. a lasagna's bolognese +
  // béchamel) — see RecipeComponent below.
  components      RecipeComponent[]  @relation("ParentRecipe")
  // Other recipes that include this one as a sub-recipe. Kept non-empty
  // blocks deletion (see deleteRecipeAction) rather than silently cascading,
  // since a recipe disappearing out from under a parent would silently
  // change what that parent means.
  usedInRecipes   RecipeComponent[]  @relation("ComponentRecipe")
  preparedBatches PreparedBatch[]

  @@index([householdId])
}

// A sub-recipe used inside another recipe — self-referential many-to-many on
// Recipe via an explicit join model (needed to carry `quantity`, and to give
// Prisma two distinct named relations for the pair of FKs that both point at
// Recipe). `quantity` is how many batches of the component recipe the parent
// needs (e.g. lasagna uses 1 batch of bolognese and 1 of béchamel); ingredient
// totals for shopping-list purposes are obtained by recursively expanding
// this graph and scaling each level's ingredients by the accumulated
// quantity — see expandRecipeIngredients in
// src/app/dashboard/meal-planning/recipe-expansion.ts. A recipe can never
// contain itself, directly or transitively — enforced in application code
// (assertNoComponentCycle in actions.ts) since Postgres has no native
// transitive-closure constraint to lean on. onDelete is Cascade on the
// parent side (deleting a recipe drops its own component list) and Restrict
// on the component side (a recipe still used as someone else's sub-recipe
// can't be deleted out from under it — see deleteRecipeAction, which checks
// this proactively for a clear error rather than letting the constraint
// throw).
model RecipeComponent {
  id                String @id @default(cuid())
  parentRecipeId    String
  componentRecipeId String
  quantity          Float  @default(1)

  parentRecipe    Recipe @relation("ParentRecipe", fields: [parentRecipeId], references: [id], onDelete: Cascade)
  componentRecipe Recipe @relation("ComponentRecipe", fields: [componentRecipeId], references: [id], onDelete: Restrict)

  @@unique([parentRecipeId, componentRecipeId])
  @@index([parentRecipeId])
  @@index([componentRecipeId])
}

model RecipeIngredient {
  id              String  @id @default(cuid())
  recipeId        String
  inventoryItemId String?
  name            String
  quantity        Float
  unit            String  @default("pcs")
  // MATCH-2 ("Don't track"): the row is deliberately not linked to any
  // InventoryItem (water, ice, or anything the household said never to
  // track), so cooking, the shopping-list bridge, cost and "use it up" skip
  // it. A row with `inventoryItemId = null` and `untracked = false` is
  // different: its item was deleted (SetNull below) or it never matched,
  // and it keeps the old match-by-name fallback.
  untracked       Boolean @default(false)
  // The original imported line ("300 g vetemjöl, siktat"), kept for the
  // cook when the row's amount is rewritten into the item's unit (MATCH-3).
  rawText         String?
  // Prep text split off an imported name ("finhackad"), shown after the
  // name on the recipe card and never used for matching.
  note            String?

  recipe        Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([inventoryItemId])
}

// MATCH-2: a household's learned "this ingredient name means that item",
// written by the recipe review when the user links a name to a differently
// named item ("eggs" → Egg) or marks it Don't track, and checked by the
// matcher right after an exact name match (src/lib/recipes/ingredient-match.ts).
// `inventoryItemId = null` means "this name is never tracked". Carries its
// own householdId because that untracked alias has no item to scope it by;
// deleting the item deletes its aliases.
model ItemAlias {
  id              String   @id @default(cuid())
  householdId     String
  // normalizeItemName() of the ingredient name, without a trailing
  // parenthesized note.
  normalizedName  String
  inventoryItemId String?
  createdAt       DateTime @default(now())

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([householdId, normalizedName])
  @@index([inventoryItemId])
}

// MATCH-3: a per-item conversion into the item's own unit: 1 `fromUnit` =
// `factor` × item.unit ("1 g = 0.0005 pcs" is stored as fromUnit "g",
// factor 0.0005, for a flour item counted in 2 kg bags). Only needed where
// src/lib/units.ts's generic table can't convert (weight↔volume,
// count↔measure); convertForItem there applies it directly or chained
// through that table. Written by the recipe review's "Remember" choice, and
// always reached through an item already checked against the household, so
// it carries no householdId of its own. Deleting the item deletes these.
model ItemUnitConversion {
  id              String   @id @default(cuid())
  inventoryItemId String
  // canonicalUnit() of the unit ("st" → "pcs", "msk" → "tbsp").
  fromUnit        String
  // > 0, validated on write.
  factor          Float
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, fromUnit])
}

// MATCH-7: "Not duplicates" on the item catalog. One row per pair of items
// the household said are different things, so findDuplicateGroups
// (src/lib/inventory/duplicates.ts) never pairs them again. Stored in the
// database rather than the browser so the answer holds for every member.
// The ids are stored sorted (itemAId < itemBId), so a pair has exactly one
// row and the unique index refuses a second. Goes with either item and with
// the household.
model InventoryDuplicateDismissal {
  id          String   @id @default(cuid())
  householdId String
  itemAId     String
  itemBId     String
  createdAt   DateTime @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  itemA     InventoryItem @relation("DismissalItemA", fields: [itemAId], references: [id], onDelete: Cascade)
  itemB     InventoryItem @relation("DismissalItemB", fields: [itemBId], references: [id], onDelete: Cascade)

  @@unique([householdId, itemAId, itemBId])
  @@index([itemAId])
  @@index([itemBId])
}

model MealPlan {
  id            String   @id @default(cuid())
  householdId   String
  weekStartDate DateTime
  createdAt     DateTime @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries   MealPlanEntry[]

  @@unique([householdId, weekStartDate])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealPlanEntry {
  id           String    @id @default(cuid())
  mealPlanId   String
  date         DateTime
  mealType     MealType
  recipeId     String?
  freeformName String?
  // How many portions of `recipe` this specific slot is cooking — lets two
  // entries of the same recipe in one week (e.g. lasagna for Thursday dinner
  // and Friday lunch) split one batch instead of each demanding a full
  // recipe's worth of ingredients. Ingredient totals for the shopping-list
  // diff (previewMissingIngredientsAction in actions.ts) scale the recipe's
  // ingredients by `portions / recipe.servings` via expandRecipeIngredients
  // in recipe-expansion.ts. Meaningless (and unused) on a freeform entry,
  // which has no recipe to scale. See Recipe.servings' doc comment for why
  // both fields share the same default.
  portions     Int       @default(4)
  // Set once inventory has been decremented for this entry via
  // markMealEntryCookedAction (src/app/dashboard/meal-planning/actions.ts) —
  // makes the action idempotent (a stale button re-click, or a double
  // submit, is a no-op) and lets the UI swap the "Mark as cooked" button for
  // a static "Cooked" indicator. Null means not yet cooked/consumed.
  // Meaningless (and unused) on a freeform entry, same as `portions`.
  consumedAt   DateTime?
  // GAP-49 meal prep: the cooked batch this slot eats from, if any. Null is
  // the normal case — the slot cooks `recipe` fresh. SetNull rather than
  // Cascade: throwing a batch away (or the batch disappearing with its
  // recipe, see PreparedBatch.recipeId) must not wipe the planned meal,
  // which still has its recipe/freeform name and simply stops claiming
  // leftovers.
  preparedBatchId      String?
  // How many of the batch's portions this slot has drawn, so unassigning or
  // deleting the entry can hand exactly that many back to
  // PreparedBatch.remainingPortions. NOT NULL with 0 rather than nullable:
  // the decrement/return arithmetic never has to special-case null, and
  // every existing row reads as "drew nothing". Only meaningful while
  // preparedBatchId is set; the assign/unassign actions keep the pair in
  // step (and reset this to 0 when they clear the link).
  preparedPortionsUsed Int       @default(0)

  mealPlan      MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe        Recipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  preparedBatch PreparedBatch? @relation(fields: [preparedBatchId], references: [id], onDelete: SetNull)
  notification  Notification?

  @@index([mealPlanId])
  @@index([preparedBatchId])
}

// GAP-49 meal prep: one batch-cooked recipe ("8 portions chicken & rice")
// whose portions are handed out to meal-plan slots over the week. Household-
// scoped like everything else (cookedByMember is attribution, not
// ownership), with integer portions — the recommended options in GAP-49's
// BACKLOG.md entry. This is the schema slice only; the actions and UI that
// move portions between a batch and MealPlanEntry.preparedPortionsUsed land
// in follow-up PRs.
model PreparedBatch {
  id                String    @id @default(cuid())
  householdId       String
  // Required, and Cascade on delete: GAP-49's data model has a batch always
  // be *of* a recipe, so a recipe-less batch would be a row the UI can't
  // name. Cascade rather than RESTRICT keeps deleteRecipeAction's plain
  // prisma.recipe.delete working (RESTRICT would make it throw an
  // untranslated FK error) — the batch goes with its recipe, and any
  // MealPlanEntry drawing from it just loses the link via its own SetNull.
  recipeId          String
  // Who cooked it, for a "cooked by" line. SetNull: a member leaving the
  // household shouldn't take the household's leftovers with them.
  cookedByMemberId  String?
  // What the cook made; fixed at creation, so the UI can show "3 of 8 left"
  // without summing entries.
  totalPortions     Int
  // Portions not yet assigned to a meal-plan slot. Assigning decrements it;
  // unassigning returns the entry's preparedPortionsUsed to it.
  remainingPortions Int
  cookedAt          DateTime  @default(now())
  // Optional "eat by" date; null means the household didn't set one.
  expiryDate        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedByMember  HouseholdMember? @relation(fields: [cookedByMemberId], references: [id], onDelete: SetNull)
  mealPlanEntries MealPlanEntry[]

  @@index([householdId])
  @@index([recipeId])
  @@index([cookedByMemberId])
}

// --- Budgeting -----------------------------------------------------------------

// SAVINGS is neither income nor an expense — money set aside for later,
// excluded from both totals wherever they're summed (PeriodSummary's net,
// safe-to-spend, etc.) and reported as its own figure instead. See the
// "Fixed income & costs" summary (recurring-template-calc.ts's
// computeFixedMonthlySummary) for where that separation matters most.
enum TransactionType {
  INCOME
  EXPENSE
  SAVINGS
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model BudgetCategory {
  id              String          @id @default(cuid())
  householdId     String
  name            String
  type            TransactionType
  // Optional monthly spending cap (GAP-12). Only meaningful on EXPENSE
  // categories (the category actions clear it for INCOME/SAVINGS) and purely
  // advisory: PeriodSummary draws the category's bar against it and turns it
  // red past 100%, but nothing blocks a transaction or sends a notification.
  // Float like every other money column (Transaction.amount etc.). Null =
  // no cap.
  monthlyLimit    Float?
  // Envelope-style carryover (GAP-21): when on, each earlier month's unspent
  // (limit − spent) is added to this month's available amount — see
  // src/lib/budget-rollover-calc.ts for where the accumulation starts and
  // why it never goes negative. Only meaningful alongside monthlyLimit; the
  // category actions store false whenever there's no limit, so a stale flag
  // can't linger on an uncapped category.
  rolloverEnabled Boolean         @default(false)
  // Optional savings goal (GAP-22): a target amount, optionally by a date.
  // Float like monthlyLimit and every other money column.
  // Only meaningful on SAVINGS categories (the category actions clear both
  // for INCOME/EXPENSE) and purely informational: the Overview tab draws a
  // progress bar and a "save ~X/month" line (src/lib/savings-goal-calc.ts),
  // but nothing notifies or blocks a transaction. goalDate is stored as UTC
  // midnight of the picked day, like Transaction.date. goalDate without
  // goalAmount is never stored — a date alone has nothing to aim at.
  goalAmount      Float?
  goalDate        DateTime?
  createdAt       DateTime        @default(now())

  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  // Back-relation of Household.shoppingExpenseCategory.
  shoppingExpenseFor Household[]         @relation("ShoppingExpenseCategory")

  @@index([householdId])
}

model Transaction {
  id                  String               @id @default(cuid())
  householdId         String
  categoryId          String
  amount              Float
  type                TransactionType
  description         String?
  date                DateTime             @default(now())
  isRecurring         Boolean              @default(false)
  recurrenceFrequency RecurrenceFrequency?
  createdByUserId     String?
  createdAt           DateTime             @default(now())
  // Recurring-bill tracking (see "Recurring budget templates" section
  // below). Set when this transaction was logged from a RecurringTemplate,
  // so the template's checklist can tell that period is fulfilled. Null on
  // every transaction not logged that way — unaffected.
  recurringTemplateId String?

  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category          BudgetCategory     @relation(fields: [categoryId], references: [id])
  // Expense splitting (opt-in — see REQUIREMENTS.md's "Household expense
  // splitting" subsection). Empty on every transaction that isn't split,
  // which behaves exactly as it did before this feature. Who paid lives on
  // the split rows (TransactionSplit.amountPaid), not here, so a bill can be
  // paid partly by several members.
  splits            TransactionSplit[]
  // SetNull: deleting a template must never delete the transactions it
  // already produced — the transaction itself must survive.
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([categoryId])
  // Budget queries filter by householdId and order/filter by date (see
  // SCALE-F's period-bounded budget query) — this composite index serves
  // that access pattern directly instead of falling back to the
  // householdId-only index above plus a sort.
  @@index([householdId, date])
}

// One row per household member included in a split transaction's cost
// share. No householdId column — like PriceHistory/RecipeIngredient, it's
// scoped through its parent (Transaction.householdId) rather than
// duplicating the tenant id. `amountOwed` is an absolute currency amount
// (not a percentage), and the sum of a transaction's splits is validated
// server-side to equal that transaction's `amount`.
//
// `amountPaid` is how much of the bill this member has actually paid
// (towards the bill itself, not to another member — that's
// MemberSettlement). It's independent of `amountOwed`: a member can pay more
// than their share (the others then owe them), less, or nothing. The sum of
// a transaction's `amountPaid` is validated to be at most its `amount`;
// whatever is left is "still due" on the bill (see settle-up-calc.ts).
// A member who paid but owes nothing still gets a row, with `amountOwed: 0`.
// Replaced the old single `Transaction.paidByMemberId`; migration
// 20260925050231_partial_payments_and_settlements backfilled it as "the
// payer paid the whole amount".
model TransactionSplit {
  id                String   @id @default(cuid())
  transactionId     String
  householdMemberId String
  amountOwed        Float
  amountPaid        Float    @default(0)
  createdAt         DateTime @default(now())

  transaction     Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Cascade: an ex-member's own split rows are simply removed with them —
  // a known simplification for an edge case explicitly out of scope here.
  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id], onDelete: Cascade)

  @@unique([transactionId, householdMemberId])
  @@index([transactionId])
  @@index([householdMemberId])
}

// A repayment between two household members that clears (some of) the debt
// the split transactions above built up — "Clear debt" in HouseholdBalances.
// `fromMember` handed `amount` to `toMember`. Balances carry over between
// months until one of these clears them (see settle-up-calc.ts); nothing
// else ever zeroes a debt. Money only moves between members here, so it's
// never income or an expense for the household's own budget. It's also not
// counted again in the payer's personal budget: their share of the split
// bill this repays already counted as spending in the bill's month (see
// src/lib/personal-budget-position.ts), so paying a member back only stops
// that debt being subtracted again as "owed from earlier months" — it
// doesn't change the number a second time.
model MemberSettlement {
  id              String   @id @default(cuid())
  householdId     String
  fromMemberId    String
  toMemberId      String
  amount          Float
  date            DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())

  household  Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // Cascade, same tradeoff TransactionSplit.householdMember makes: an
  // ex-member's repayments go with their split rows, so their balance
  // disappears as a whole instead of leaving half of it behind.
  fromMember HouseholdMember @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   HouseholdMember @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@index([householdId, date])
  @@index([fromMemberId])
  @@index([toMemberId])
}

// A recurring bill the household expects every period (week/month/year) —
// e.g. "Rent", "Netflix". Distinct from `Transaction.isRecurring` (which
// just flags a single logged transaction as one of a series): a template is
// the standing expectation itself, checked off per period either by
// logging a real Transaction from it (`Transaction.recurringTemplateId`) or
// by a no-transaction RecurringTemplateAck — e.g. a bill on autopay from an
// account this app doesn't otherwise track. `active: false` pauses a
// template (e.g. a cancelled subscription) without losing its history.
model RecurringTemplate {
  id          String              @id @default(cuid())
  householdId String
  categoryId  String
  name        String
  amount      Float
  type        TransactionType
  frequency   RecurrenceFrequency
  // Day-of-month hint (1-31) for display only, e.g. "due on the 3rd" — never
  // used to compute the period a transaction/ack falls into (see
  // recurring-template-calc.ts's getPeriodKey, which only looks at the
  // date). Meaningless (and ignored) for WEEKLY/YEARLY templates.
  dayOfMonth  Int?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())

  household        Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category         BudgetCategory           @relation(fields: [categoryId], references: [id])
  acknowledgements RecurringTemplateAck[]
  transactions     Transaction[]
  // Opt-in split of this template's expected cost among household members —
  // see RecurringTemplateSplit's doc comment below. Empty for every
  // pre-existing template (no backfill), same "opt-in, unaffected until
  // used" convention Transaction.splits already follows.
  splits           RecurringTemplateSplit[]

  @@index([householdId])
  @@index([categoryId])
}

// One row per household member included in a recurring template's expected
// cost share — mirrors TransactionSplit exactly (see its doc comment above),
// but for the *template* rather than a posted Transaction. This is what lets
// a "due" period (no Transaction logged yet) still carry a per-member share,
// which is what makes it possible to surface e.g. "Rent" as due in a
// member's Personal Budget before anyone has logged it there (see
// docs/archive/PERSONAL_HOUSEHOLD_BUDGET_LINK.md). No `amountPaid` counterpart here —
// unlike a Transaction, a template is never itself "paid", so only the
// split shares matter. `amountOwed` is an absolute currency amount, and the
// sum of a template's splits is validated server-side to equal the
// template's `amount`, the same convention parseSplitFormData already
// enforces for TransactionSplit.
model RecurringTemplateSplit {
  id                  String   @id @default(cuid())
  recurringTemplateId String
  householdMemberId   String
  amountOwed          Float
  createdAt           DateTime @default(now())

  recurringTemplate RecurringTemplate @relation(fields: [recurringTemplateId], references: [id], onDelete: Cascade)
  // Cascade: an ex-member's own split rows are simply removed with them,
  // same tradeoff TransactionSplit.householdMember makes.
  householdMember   HouseholdMember   @relation(fields: [householdMemberId], references: [id], onDelete: Cascade)

  @@unique([recurringTemplateId, householdMemberId])
  @@index([recurringTemplateId])
  @@index([householdMemberId])
}

// A period (see recurring-template-calc.ts's getPeriodKey for the string
// format per frequency) explicitly marked "accounted for" without a
// logged Transaction. The unique constraint makes acknowledging a period
// idempotent (repeat clicks just no-op against the same row — the upsert in
// acknowledgeTemplatePeriodAction never overwrites createdByUserId on a
// repeat click, so the original acknowledger stays attributed).
model RecurringTemplateAck {
  id                  String   @id @default(cuid())
  recurringTemplateId String
  periodKey           String
  // Who acknowledged this period — set once, on create, by
  // acknowledgeTemplatePeriodAction (src/app/dashboard/budget/actions.ts).
  // Plain-string (no @relation), mirroring Transaction.createdByUserId's
  // shape: resolved to a display name via a household-member lookup in the
  // Recurring items panel rather than a Prisma join. Null for any ack row
  // that predates this field (no backfill) — the UI falls back to an
  // unattributed "Marked accounted for" in that case, same convention
  // InventoryItem.updatedByUserId's absent-name fallback uses.
  createdByUserId     String?
  createdAt           DateTime @default(now())

  recurringTemplate RecurringTemplate @relation(fields: [recurringTemplateId], references: [id], onDelete: Cascade)

  @@unique([recurringTemplateId, periodKey])
  @@index([recurringTemplateId])
}

// --- Personal budget ---------------------------------------------------------
// A user's own budget, kept separate from any household's — scoped by
// userId rather than householdId, with no splitting/paid-by concept since
// there's only ever one person on it. See AGENTS.md's "Personal hub" work:
// mirrors BudgetCategory/Transaction's shape so the pure calc helpers
// (safe-to-spend-calc.ts) and summary/safe-to-spend components can be
// reused as-is.

model PersonalBudgetCategory {
  id              String          @id @default(cuid())
  userId          String
  name            String
  type            TransactionType
  // Mirrors BudgetCategory.monthlyLimit (GAP-12): CategoryManager and
  // PeriodSummary serve both budgets, so the cap exists on both.
  monthlyLimit    Float?
  // Mirrors BudgetCategory.rolloverEnabled (GAP-21), for the same reason.
  rolloverEnabled Boolean         @default(false)
  // Mirrors BudgetCategory.goalAmount/goalDate (GAP-22), for the same reason.
  goalAmount      Float?
  goalDate        DateTime?
  createdAt       DateTime        @default(now())

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       PersonalTransaction[]
  recurringTemplates PersonalRecurringTemplate[]

  @@index([userId])
}

model PersonalTransaction {
  id                  String               @id @default(cuid())
  userId              String
  categoryId          String
  amount              Float
  type                TransactionType
  description         String?
  date                DateTime             @default(now())
  isRecurring         Boolean              @default(false)
  recurrenceFrequency RecurrenceFrequency?
  createdAt           DateTime             @default(now())
  // Mirrors Transaction.recurringTemplateId — see RecurringTemplate's
  // doc comment above.
  recurringTemplateId String?

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          PersonalBudgetCategory     @relation(fields: [categoryId], references: [id])
  recurringTemplate PersonalRecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
  @@index([recurringTemplateId])
}

// Personal-budget mirror of RecurringTemplate/RecurringTemplateAck — see
// their doc comments above for the "accounted for" model. Kept as a
// straight duplicate rather than a shared/polymorphic table, same
// convention as PersonalBudgetCategory/PersonalTransaction themselves.
model PersonalRecurringTemplate {
  id         String              @id @default(cuid())
  userId     String
  categoryId String
  name       String
  amount     Float
  type       TransactionType
  frequency  RecurrenceFrequency
  dayOfMonth Int?
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())

  user             User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         PersonalBudgetCategory         @relation(fields: [categoryId], references: [id])
  acknowledgements PersonalRecurringTemplateAck[]
  transactions     PersonalTransaction[]

  @@index([userId])
  @@index([categoryId])
}

model PersonalRecurringTemplateAck {
  id                          String   @id @default(cuid())
  personalRecurringTemplateId String
  periodKey                   String
  createdAt                   DateTime @default(now())

  personalRecurringTemplate PersonalRecurringTemplate @relation(fields: [personalRecurringTemplateId], references: [id], onDelete: Cascade)

  @@unique([personalRecurringTemplateId, periodKey])
  @@index([personalRecurringTemplateId])
}

// --- Household tasks ---------------------------------------------------------
// Shared task list for adult household co-managers (see docs/archive/JOY_GAP_BACKLOG.md
// item 6, "Household Tasks v1") — explicitly not a chore-chart/points/rewards
// system like Tody or OurHome (see that item's Scope note): no fixed due
// date, no per-person scoring. `completedAt` nullable-timestamp-as-status (not a
// boolean/enum) mirrors MealPlanEntry.consumedAt. `assignedToMemberId`/
// `completedByMemberId` are two distinct, independently nullable fields — a
// task can be completed by someone other than whoever it was assigned to,
// and an unassigned task can still be completed. Both use onDelete: SetNull
// (never Cascade), the same tradeoff Transaction.recurringTemplateId makes:
// removing a household member unassigns/un-attributes their tasks rather
// than deleting task history.
// `recurrenceIntervalDays` (nullable) is the whole recurrence model: no
// rrule/weekday schedule, just "reopen N days after it was last completed".
// See src/app/dashboard/tasks/recurrence.ts for how a recurring task's
// open/completed state is derived lazily from `completedAt` + this interval
// at read time — completing it again simply overwrites `completedAt`, so no
// separate completion-history table is needed.
// GAP-38: `rotationMemberIds` is an opt-in round-robin ("take turns") on a
// recurring task — an ordered list of HouseholdMember ids; empty means no
// rotation. Only valid alongside `recurrenceIntervalDays` and with ≥2
// members (enforced in src/app/dashboard/tasks/actions.ts). A String[]
// rather than a join table, same call Household.categoryOrderManual makes:
// the list is only ever read and written whole, in order, and never queried
// by member, so a join table would add a position column and a reorder
// dance for nothing. The cost is no FK — a member who leaves stays in the
// array — which nextAssigneeInRotation (src/lib/task-rotation.ts) handles by
// skipping anyone no longer in the household (while still using their slot
// to find "who's after them"), and the next save of the task drops them.
// `rotationPreviousAssigneeId` is who the task was assigned to just before
// the last completion advanced it, so un-completing (undo) puts the turn
// back instead of advancing again. Also a plain id without an FK: undo
// checks it's still a member before restoring it. An explicit edit resets it
// to whoever the edit assigned, so undo never reverts a human's choice.
model HouseholdTask {
  id                     String    @id @default(cuid())
  householdId            String
  title                  String
  assignedToMemberId     String?
  completedAt            DateTime?
  completedByMemberId    String?
  recurrenceIntervalDays Int?
  rotationMemberIds          String[]  @default([])
  rotationPreviousAssigneeId String?
  createdAt              DateTime  @default(now())

  household         Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignedToMember  HouseholdMember? @relation("TaskAssignedTo", fields: [assignedToMemberId], references: [id], onDelete: SetNull)
  completedByMember HouseholdMember? @relation("TaskCompletedBy", fields: [completedByMemberId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([assignedToMemberId])
}

// GAP-16: a shared household notes board — free-text notes ("the plumber's
// coming Thursday", "don't buy the other coffee") that don't fit a shopping
// item or a task. Deliberately minimal: add + delete only, no edit, pinning
// or rich text, and never a notification trigger (a bell badge must mean
// something's wrong; a note is just something you check). See
// src/app/dashboard/household/notes-actions.ts.
// `authorMemberId` uses onDelete: SetNull (never Cascade), the same tradeoff
// HouseholdTask.completedByMemberId makes: removing a member keeps the notes
// they wrote (still useful to everyone else) and the UI falls back to a
// "former member" label instead of the notes silently disappearing.
model HouseholdNote {
  id             String   @id @default(cuid())
  householdId    String
  authorMemberId String?
  body           String
  createdAt      DateTime @default(now())

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  authorMember HouseholdMember? @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([householdId])
}

// GAP-27: one row per weekly digest email actually handed to Resend, keyed by
// recipient, household and the Monday (UTC, yyyy-mm-dd) of the week it
// covers. The unique constraint is the idempotency guard: the cron route
// claims a row *before* sending (see src/lib/weekly-digest.ts), so a retried
// or duplicated invocation in the same week — Vercel can deliver a cron
// twice — hits the constraint instead of emailing the same person again.
// Per household rather than per user alone because a member of two
// households gets one digest for each. Old rows are pruned by the same cron
// run; they're only ever needed for the current week.
model WeeklyDigestSend {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  weekKey     String
  sentAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId, weekKey])
  @@index([householdId])
  @@index([sentAt])
}
