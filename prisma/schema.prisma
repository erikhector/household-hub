// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Accounts & households -------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  // Null = unverified. Set once by verifyEmailAction (src/lib/actions/auth.ts)
  // when a valid EmailVerificationToken is redeemed. This is a soft gate —
  // see EmailVerificationToken's doc comment below: an unverified user keeps
  // full access, just with a dismissible-once-verified banner in the
  // dashboard (src/components/dashboard/email-verification-banner.tsx)
  // rather than being blocked anywhere.
  emailVerifiedAt DateTime?

  memberships                HouseholdMember[]
  personalBudgetCategories   PersonalBudgetCategory[]
  personalTransactions       PersonalTransaction[]
  personalRecurringTemplates PersonalRecurringTemplate[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  pushSubscriptions          PushSubscription[]
}

// One row per subscribed browser/device (src/lib/actions/push.ts). Per-user
// rather than per-household — a subscription belongs to one browser, and a
// user can belong to multiple households (src/lib/session.ts's
// requireHousehold). sendPushToHousehold (src/lib/push.ts) fans out to every
// member's subscriptions when a notification fires.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum HouseholdRole {
  OWNER
  CONTRIBUTOR
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members            HouseholdMember[]
  invitations        Invitation[]
  inventoryItems     InventoryItem[]
  shoppingLists      ShoppingList[]
  recipes            Recipe[]
  mealPlans          MealPlan[]
  budgetCategories   BudgetCategory[]
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  notifications      Notification[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(CONTRIBUTOR)
  createdAt   DateTime      @default(now())

  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidTransactions  Transaction[]      @relation("TransactionPaidBy")
  transactionSplits TransactionSplit[]

  @@unique([householdId, userId])
}

model Invitation {
  id          String    @id @default(cuid())
  householdId String
  token       String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// Password-reset link, same token-based/time-limited shape as Invitation
// above. Unlike an invite link (an intentional, always-visible fallback for
// the inviting household owner), this token must only ever reach its owner
// via email — see requestPasswordResetAction/sendPasswordResetEmail in
// src/lib/actions/auth.ts / src/lib/email.ts. `expiresAt` is 1 hour from
// creation (vs. Invitation's 7 days): a reset link grants account takeover
// to whoever holds it, a much higher-value target than a household invite,
// and password-reset emails typically arrive within seconds — an hour is
// generous for a legitimate user while keeping a leaked/intercepted link's
// window small. `usedAt` marks it consumed (mirrors Invitation.acceptedAt);
// a fresh request invalidates a user's other outstanding unused tokens (see
// requestPasswordResetAction) so an old leaked link stops working.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email-verification link, same token-based/time-limited shape as
// PasswordResetToken above — see signupAction/sendVerificationEmail/
// verifyEmailAction/resendVerificationEmailAction in
// src/lib/actions/auth.ts / src/lib/email.ts. `expiresAt` is 36 hours from
// creation: shorter than Invitation's 7 days (an unverified signup
// shouldn't linger indefinitely, and a stale token is worthless anyway once
// resent), but well past PasswordResetToken's 1 hour, since holding this
// token grants no account access or takeover — the worst it can do is mark
// an email verified, which the legitimate owner wanted anyway. 36 hours
// covers a full day-plus for someone who signs up before bed and checks
// email the next morning, without leaving months-old links live. `usedAt`
// marks it consumed (mirrors PasswordResetToken.usedAt); both a fresh
// signup-time send and a resend request invalidate a user's other
// outstanding unused tokens (see resendVerificationEmailAction) so old
// leaked/stale links stop working.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Inventory & shopping ---------------------------------------------------

model InventoryItem {
  id                String   @id @default(cuid())
  householdId       String
  name              String
  category          String
  quantity          Float    @default(0)
  unit              String   @default("pcs")
  lowStockThreshold Float    @default(1)
  location          String?
  lastKnownPrice    Float?
  // Optional best-before/expiry date, set from the add/edit item form. Feeds
  // the "expiring soon" table indicator and notification trigger (see
  // src/lib/inventory/expiry.ts, src/lib/notifications.ts) — never set by
  // any bulk-add flow (scan queue, paste-list, starter kit), only the
  // single-item form.
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // Who last touched this row — set on every mutation (edits, quantity
  // +/- taps, mark-empty, bulk field edits) by src/app/dashboard/inventory/
  // actions.ts, mirroring Transaction.createdByUserId's plain-string
  // (no @relation) shape: resolved to a display name via a household-member
  // lookup in the inventory page rather than a Prisma join. Surfaced next to
  // `updatedAt` in the inventory table/detail view so a household can spot
  // items that haven't been touched (and recounted) in a while.
  updatedByUserId   String?

  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  shoppingListItems ShoppingListItem[]
  priceHistory      PriceHistory[]
  recipeIngredients RecipeIngredient[]
  notifications     Notification[]

  @@index([householdId])
}

enum NotificationKind {
  OUT_OF_STOCK
  MEAL_NOT_LOGGED
  EXPIRING_SOON
}

// Persisted household alerts (see src/lib/notifications.ts) — replaces an
// earlier design with no table at all, where every alert was recomputed
// live on each render. Three triggers only, all fired at the moment they
// happen rather than recomputed:
// - OUT_OF_STOCK: an existing InventoryItem's quantity crossing from > 0
//   into <= 0. Never fired for items created at zero (recipe-ingredient
//   auto-create, the add-item dialog, starter kits, quick-add) — those are
//   new items, not a depletion event. See recordOutOfStockTransition.
// - MEAL_NOT_LOGGED: a past MealPlanEntry found with `consumedAt` still
//   null. Fired lazily (no background job) the first time
//   getActiveNotifications runs after that becomes true. The @@unique on
//   mealPlanEntryId makes this fire at most once per entry, ever —
//   dismissing it (or ignoring it) never brings it back.
// - EXPIRING_SOON: an InventoryItem with `expiresAt` set, still in stock,
//   within EXPIRY_WARNING_DAYS of its expiry date (or already past it).
//   Fired lazily the same way MEAL_NOT_LOGGED is, but deduped like
//   OUT_OF_STOCK (an application-level check for an existing undismissed
//   alert for the same item, not a DB unique constraint) since an item can
//   legitimately be re-stocked with a new expiry date after the old alert
//   was dismissed. See syncExpiringSoonNotifications.
// `dismissedAt` is set the moment a user clicks the notification (see
// dismissNotificationAction) — dismissed rows are kept, not deleted, so
// MEAL_NOT_LOGGED's once-ever guarantee holds, and are simply excluded from
// what the bell displays. Unlike the old live-computed model, a
// notification does NOT clear itself when the underlying condition
// resolves (e.g. restocking) — dismissal is the only way to clear it.
model Notification {
  id              String           @id @default(cuid())
  householdId     String
  kind            NotificationKind
  inventoryItemId String?
  mealPlanEntryId String?
  createdAt       DateTime         @default(now())
  dismissedAt     DateTime?

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  mealPlanEntry MealPlanEntry? @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)

  @@unique([mealPlanEntryId])
  @@index([householdId, dismissedAt])
  @@index([inventoryItemId])
}

enum ShoppingListStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model ShoppingList {
  id          String             @id @default(cuid())
  householdId String
  name        String
  status      ShoppingListStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  completedAt DateTime?
  archivedAt  DateTime?

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@index([householdId])
}

model ShoppingListItem {
  id                 String   @id @default(cuid())
  shoppingListId     String
  inventoryItemId    String?
  name               String
  quantity           Float    @default(1)
  unit               String   @default("pcs")
  estimatedPrice     Float?
  purchased          Boolean  @default(false)
  addedAutomatically Boolean  @default(false)
  createdAt          DateTime @default(now())

  shoppingList  ShoppingList   @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([shoppingListId])
}

model PriceHistory {
  id              String   @id @default(cuid())
  inventoryItemId String
  price           Float
  store           String?
  date            DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
}

// --- Meal planning -----------------------------------------------------------

model Recipe {
  id           String   @id @default(cuid())
  householdId  String
  name         String
  instructions String?
  // How many portions the ingredient quantities on this recipe (as entered)
  // actually make. MealPlanEntry.portions is scaled against this — see its
  // doc comment below — so ingredient totals for a meal-plan entry reflect
  // how many portions that specific slot is cooking, not always "one full
  // recipe." Defaults to 4 (a common household recipe size) both here and
  // on MealPlanEntry.portions so pre-existing rows keep a 1:1 ratio — i.e.
  // no behavior change — until a household actively edits either value.
  servings     Int      @default(4)
  createdAt    DateTime @default(now())
  // Optional, manual-entry-only nutrition info — never fetched from an
  // external nutrition-lookup API (that's a separate, larger effort needing
  // its own SSRF-safe-fetch review, same as the recipe-URL-import feature
  // above). All four are per-serving (not raw recipe totals) since
  // `servings` already exists and per-serving figures are what's actually
  // useful on a recipe card. Null on every field means "not entered" —
  // RecipeManager only renders a nutrition line when at least one is set.
  caloriesPerServing     Int?
  proteinGramsPerServing Float?
  carbsGramsPerServing   Float?
  fatGramsPerServing     Float?

  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredients     RecipeIngredient[]
  mealPlanEntries MealPlanEntry[]
  // Sub-recipes this recipe includes (e.g. a lasagna's bolognese +
  // béchamel) — see RecipeComponent below.
  components      RecipeComponent[]  @relation("ParentRecipe")
  // Other recipes that include this one as a sub-recipe. Kept non-empty
  // blocks deletion (see deleteRecipeAction) rather than silently cascading,
  // since a recipe disappearing out from under a parent would silently
  // change what that parent means.
  usedInRecipes   RecipeComponent[]  @relation("ComponentRecipe")

  @@index([householdId])
}

// A sub-recipe used inside another recipe — self-referential many-to-many on
// Recipe via an explicit join model (needed to carry `quantity`, and to give
// Prisma two distinct named relations for the pair of FKs that both point at
// Recipe). `quantity` is how many batches of the component recipe the parent
// needs (e.g. lasagna uses 1 batch of bolognese and 1 of béchamel); ingredient
// totals for shopping-list purposes are obtained by recursively expanding
// this graph and scaling each level's ingredients by the accumulated
// quantity — see expandRecipeIngredients in
// src/app/dashboard/meal-planning/recipe-expansion.ts. A recipe can never
// contain itself, directly or transitively — enforced in application code
// (assertNoComponentCycle in actions.ts) since Postgres has no native
// transitive-closure constraint to lean on. onDelete is Cascade on the
// parent side (deleting a recipe drops its own component list) and Restrict
// on the component side (a recipe still used as someone else's sub-recipe
// can't be deleted out from under it — see deleteRecipeAction, which checks
// this proactively for a clear error rather than letting the constraint
// throw).
model RecipeComponent {
  id                String @id @default(cuid())
  parentRecipeId    String
  componentRecipeId String
  quantity          Float  @default(1)

  parentRecipe    Recipe @relation("ParentRecipe", fields: [parentRecipeId], references: [id], onDelete: Cascade)
  componentRecipe Recipe @relation("ComponentRecipe", fields: [componentRecipeId], references: [id], onDelete: Restrict)

  @@unique([parentRecipeId, componentRecipeId])
  @@index([parentRecipeId])
  @@index([componentRecipeId])
}

model RecipeIngredient {
  id              String  @id @default(cuid())
  recipeId        String
  inventoryItemId String?
  name            String
  quantity        Float
  unit            String  @default("pcs")

  recipe        Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([recipeId])
}

model MealPlan {
  id            String   @id @default(cuid())
  householdId   String
  weekStartDate DateTime
  createdAt     DateTime @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries   MealPlanEntry[]

  @@unique([householdId, weekStartDate])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealPlanEntry {
  id           String   @id @default(cuid())
  mealPlanId   String
  date         DateTime
  mealType     MealType
  recipeId     String?
  freeformName String?
  // How many portions of `recipe` this specific slot is cooking — lets two
  // entries of the same recipe in one week (e.g. lasagna for Thursday dinner
  // and Friday lunch) split one batch instead of each demanding a full
  // recipe's worth of ingredients. Ingredient totals for the shopping-list
  // diff (previewMissingIngredientsAction in actions.ts) scale the recipe's
  // ingredients by `portions / recipe.servings` via expandRecipeIngredients
  // in recipe-expansion.ts. Meaningless (and unused) on a freeform entry,
  // which has no recipe to scale. See Recipe.servings' doc comment for why
  // both fields share the same default.
  portions     Int      @default(4)
  // Set once inventory has been decremented for this entry via
  // markMealEntryCookedAction (src/app/dashboard/meal-planning/actions.ts) —
  // makes the action idempotent (a stale button re-click, or a double
  // submit, is a no-op) and lets the UI swap the "Mark as cooked" button for
  // a static "Cooked" indicator. Null means not yet cooked/consumed.
  // Meaningless (and unused) on a freeform entry, same as `portions`.
  consumedAt   DateTime?

  mealPlan     MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe       Recipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  notification Notification?

  @@index([mealPlanId])
}

// --- Budgeting -----------------------------------------------------------------

// SAVINGS is neither income nor an expense — money set aside for later,
// excluded from both totals wherever they're summed (PeriodSummary's net,
// safe-to-spend, etc.) and reported as its own figure instead. See the
// "Fixed income & costs" summary (recurring-template-calc.ts's
// computeFixedMonthlySummary) for where that separation matters most.
enum TransactionType {
  INCOME
  EXPENSE
  SAVINGS
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model BudgetCategory {
  id          String          @id @default(cuid())
  householdId String
  name        String
  type        TransactionType
  createdAt   DateTime        @default(now())

  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]

  @@index([householdId])
}

model Transaction {
  id                  String               @id @default(cuid())
  householdId         String
  categoryId          String
  amount              Float
  type                TransactionType
  description         String?
  date                DateTime             @default(now())
  isRecurring         Boolean              @default(false)
  recurrenceFrequency RecurrenceFrequency?
  createdByUserId     String?
  createdAt           DateTime             @default(now())
  // Expense splitting (opt-in — see REQUIREMENTS.md's "Household expense
  // splitting" subsection). Null on every transaction that isn't split,
  // which behaves exactly as it did before this feature.
  paidByMemberId      String?
  // Recurring-bill tracking (see "Recurring budget templates" section
  // below). Set when this transaction was logged from a RecurringTemplate,
  // so the template's checklist can tell that period is fulfilled. Null on
  // every transaction not logged that way — unaffected.
  recurringTemplateId String?

  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category          BudgetCategory     @relation(fields: [categoryId], references: [id])
  // SetNull (not Cascade): if the paying member later leaves the household,
  // the transaction itself must survive — it just loses the "paid by" note,
  // the same tradeoff RecipeIngredient.inventoryItemId makes.
  paidByMember      HouseholdMember?   @relation("TransactionPaidBy", fields: [paidByMemberId], references: [id], onDelete: SetNull)
  splits            TransactionSplit[]
  // SetNull: deleting a template must never delete the transactions it
  // already produced, same tradeoff as paidByMember above.
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@index([householdId])
}

// One row per household member included in a split transaction's cost
// share. No householdId column — like PriceHistory/RecipeIngredient, it's
// scoped through its parent (Transaction.householdId) rather than
// duplicating the tenant id. `amountOwed` is an absolute currency amount
// (not a percentage), and the sum of a transaction's splits is validated
// server-side to equal that transaction's `amount`.
model TransactionSplit {
  id                String   @id @default(cuid())
  transactionId     String
  householdMemberId String
  amountOwed        Float
  createdAt         DateTime @default(now())

  transaction     Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Cascade: an ex-member's own split rows are simply removed with them —
  // a known simplification for an edge case explicitly out of scope here.
  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id], onDelete: Cascade)

  @@unique([transactionId, householdMemberId])
  @@index([transactionId])
  @@index([householdMemberId])
}

// A recurring bill the household expects every period (week/month/year) —
// e.g. "Rent", "Netflix". Distinct from `Transaction.isRecurring` (which
// just flags a single logged transaction as one of a series): a template is
// the standing expectation itself, checked off per period either by
// logging a real Transaction from it (`Transaction.recurringTemplateId`) or
// by a no-transaction RecurringTemplateAck — e.g. a bill on autopay from an
// account this app doesn't otherwise track. `active: false` pauses a
// template (e.g. a cancelled subscription) without losing its history.
model RecurringTemplate {
  id          String              @id @default(cuid())
  householdId String
  categoryId  String
  name        String
  amount      Float
  type        TransactionType
  frequency   RecurrenceFrequency
  // Day-of-month hint (1-31) for display only, e.g. "due on the 3rd" — never
  // used to compute the period a transaction/ack falls into (see
  // recurring-template-calc.ts's getPeriodKey, which only looks at the
  // date). Meaningless (and ignored) for WEEKLY/YEARLY templates.
  dayOfMonth  Int?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())

  household        Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category         BudgetCategory         @relation(fields: [categoryId], references: [id])
  acknowledgements RecurringTemplateAck[]
  transactions     Transaction[]

  @@index([householdId])
}

// A period (see recurring-template-calc.ts's getPeriodKey for the string
// format per frequency) explicitly marked "accounted for" without a
// logged Transaction. The unique constraint makes acknowledging a period
// idempotent (repeat clicks just no-op against the same row).
model RecurringTemplateAck {
  id                  String   @id @default(cuid())
  recurringTemplateId String
  periodKey           String
  createdAt           DateTime @default(now())

  recurringTemplate RecurringTemplate @relation(fields: [recurringTemplateId], references: [id], onDelete: Cascade)

  @@unique([recurringTemplateId, periodKey])
  @@index([recurringTemplateId])
}

// --- Personal budget ---------------------------------------------------------
// A user's own budget, kept separate from any household's — scoped by
// userId rather than householdId, with no splitting/paid-by concept since
// there's only ever one person on it. See AGENTS.md's "Personal hub" work:
// mirrors BudgetCategory/Transaction's shape so the pure calc helpers
// (safe-to-spend-calc.ts) and summary/safe-to-spend components can be
// reused as-is.

model PersonalBudgetCategory {
  id        String          @id @default(cuid())
  userId    String
  name      String
  type      TransactionType
  createdAt DateTime        @default(now())

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       PersonalTransaction[]
  recurringTemplates PersonalRecurringTemplate[]

  @@index([userId])
}

model PersonalTransaction {
  id                  String               @id @default(cuid())
  userId              String
  categoryId          String
  amount              Float
  type                TransactionType
  description         String?
  date                DateTime             @default(now())
  isRecurring         Boolean              @default(false)
  recurrenceFrequency RecurrenceFrequency?
  createdAt           DateTime             @default(now())
  // Mirrors Transaction.recurringTemplateId — see RecurringTemplate's
  // doc comment above.
  recurringTemplateId String?

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          PersonalBudgetCategory     @relation(fields: [categoryId], references: [id])
  recurringTemplate PersonalRecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Personal-budget mirror of RecurringTemplate/RecurringTemplateAck — see
// their doc comments above for the "accounted for" model. Kept as a
// straight duplicate rather than a shared/polymorphic table, same
// convention as PersonalBudgetCategory/PersonalTransaction themselves.
model PersonalRecurringTemplate {
  id         String              @id @default(cuid())
  userId     String
  categoryId String
  name       String
  amount     Float
  type       TransactionType
  frequency  RecurrenceFrequency
  dayOfMonth Int?
  active     Boolean             @default(true)
  createdAt  DateTime            @default(now())

  user             User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         PersonalBudgetCategory         @relation(fields: [categoryId], references: [id])
  acknowledgements PersonalRecurringTemplateAck[]
  transactions     PersonalTransaction[]

  @@index([userId])
}

model PersonalRecurringTemplateAck {
  id                          String   @id @default(cuid())
  personalRecurringTemplateId String
  periodKey                   String
  createdAt                   DateTime @default(now())

  personalRecurringTemplate PersonalRecurringTemplate @relation(fields: [personalRecurringTemplateId], references: [id], onDelete: Cascade)

  @@unique([personalRecurringTemplateId, periodKey])
  @@index([personalRecurringTemplateId])
}
