# Copy to .env and fill in values for your environment.

# Postgres connection string. Matches docker-compose.yml's default local
# credentials — change if you point this at a different Postgres instance
# (Supabase, Neon, RDS, ...).
DATABASE_URL="postgresql://household:household@localhost:5432/household_hub"

# Household invite emails (src/lib/email.ts, sendInviteEmailAction in
# src/lib/actions/household.ts). Get a key at https://resend.com — without
# it, sending fails gracefully and the on-screen invite link (always shown)
# still works as a manual copy/paste fallback.
RESEND_API_KEY=""

# Optional. Sender shown on invite emails, e.g. "Household Hub <invites@yourdomain.com>".
# Must be a domain verified in Resend. Defaults to Resend's shared
# onboarding@resend.dev sender (no verification needed) when unset.
EMAIL_FROM=""
