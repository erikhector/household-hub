# Copy to .env and fill in values for your environment.

# Postgres connection string. Matches docker-compose.yml's default local
# credentials — change if you point this at a different Postgres instance
# (Supabase, Neon, RDS, ...).
DATABASE_URL="postgresql://household:household@localhost:5432/household_hub"

# Optional. Only needed once a connection pooler (PgBouncer, or a managed
# provider's built-in pooler like Neon/Supabase) sits in front of
# DATABASE_URL in production — see DEPLOYMENT.md's "Connection pooling"
# section. DIRECT_URL is the unpooled, direct-to-Postgres connection string,
# used only by the Prisma CLI for `prisma migrate deploy`/`migrate dev`
# (transaction-mode pooling doesn't support what the migration engine
# needs). Leave unset for local dev (no pooler).
DIRECT_URL=""

# Household invite emails (src/lib/email.ts, sendInviteEmailAction in
# src/lib/actions/household.ts). Get a key at https://resend.com — without
# it, sending fails gracefully and the on-screen invite link (always shown)
# still works as a manual copy/paste fallback.
RESEND_API_KEY=""

# Optional. Sender shown on invite emails, e.g. "Squirrel <invites@yourdomain.com>".
# Must be a domain verified in Resend. Defaults to Resend's shared
# onboarding@resend.dev sender (no verification needed) when unset.
EMAIL_FROM=""

# The app's own public base URL (no trailing slash), e.g.
# "https://household-hub.example.com". Used to build the link inside invite
# emails (src/lib/actions/household.ts). REQUIRED in production: without it,
# that link falls back to the request's Host header, which a caller can set
# to an arbitrary value and get this app to email out a link to a
# domain they control instead. Safe to leave unset for local dev only
# (falls back to http://localhost:3000).
APP_URL=""

# Auth.js (NextAuth v5, src/lib/auth.ts) signing/encryption key for session
# JWTs and cookies. REQUIRED in production — generate a real one with
# `npx auth secret` (writes a strong random value straight into .env) and
# keep it out of source control. The value below is a dev-only placeholder;
# never reuse it anywhere real.
AUTH_SECRET="dev-only-secret-change-me-32-characters-minimum"

# Optional. Shared, durable rate-limit store (src/lib/rate-limit.ts) backed
# by Upstash Redis's REST API — get a free database at https://upstash.com
# (Redis > Create Database), then copy its "REST API" URL and token here.
# Without both set, login/signup/join-via-invite throttling falls back to an
# in-memory counter that resets on every restart and does NOT share state
# across instances — fine for local dev or a single server instance, but on
# any multi-instance or serverless deployment each instance/invocation gets
# its own independent budget and brute-force protection silently degrades
# (a console.warn fires in production if this happens). REQUIRED once this
# app runs on more than one instance. See DEPLOYMENT.md for details.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error tracking (Sentry — src/instrumentation.ts, src/instrumentation-client.ts,
# next.config.ts). Fully optional: with these unset, Sentry is never
# initialized anywhere (server, edge, or browser) — no network calls, no
# build-time plugin, nothing. Get a free DSN at https://sentry.io by
# creating a project (Platform: Next.js).
#
# Server/edge DSN, read directly by src/instrumentation.ts.
SENTRY_DSN=""
# Same DSN, but NEXT_PUBLIC_-prefixed so it's readable from the browser
# bundle by src/instrumentation-client.ts — client-side code can only see
# env vars with this prefix. Set to the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=""

# Optional. Only needed to enable source-map upload at build time (so
# stack traces in Sentry show your original TypeScript instead of minified
# output) — get one at https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/.
# Skippable: the build succeeds without it (and without SENTRY_DSN too) —
# see next.config.ts's `sourcemaps: { disable: !SENTRY_AUTH_TOKEN }`. CI and
# local dev are expected to leave this, and everything else in this block,
# unset.
SENTRY_AUTH_TOKEN=""
# Optional, only used alongside SENTRY_AUTH_TOKEN for source-map upload.
SENTRY_ORG=""
SENTRY_PROJECT=""

# Web Push (src/lib/push.ts, src/components/profile/push-notifications-card.tsx).
# Lets the notification center (src/lib/notifications.ts) also deliver a
# real device/OS notification for its two triggers (out-of-stock,
# meal-not-logged), on top of the in-app bell. Generate a key pair with
# `npx web-push generate-vapid-keys` and paste both values below — without
# them set, push sending is a silent no-op and the Profile page's push card
# explains notifications aren't configured, same fails-gracefully pattern as
# RESEND_API_KEY above.
#
# Public key, NEXT_PUBLIC_-prefixed so the browser can read it when calling
# `pushManager.subscribe()`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Private key. Keep this out of source control — it lets whoever holds it
# send push messages to every subscribed browser.
VAPID_PRIVATE_KEY=""

# AI shelf scan (beta) — src/lib/actions/inventory-scan.ts, the "Scan a
# shelf" button on the Inventory page. Unlike the barcode scanner and
# receipt scanner (both fully client-side, photo never leaves the device),
# this feature sends the photo itself to a third-party API for analysis —
# the dialog says so before anyone snaps a photo. Without either key below
# set, the button explains the feature isn't configured, same
# fails-gracefully pattern as RESEND_API_KEY above.
#
# Two providers are supported; GEMINI_API_KEY is tried first when both are
# set. Prefer Gemini if you just want to try this feature for free — Google
# AI Studio's free tier needs no card. Get a key at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=""
# Optional. Overrides the primary Gemini model used for shelf scans (e.g.
# to pin a specific version instead of the auto-updating "-latest" alias).
GEMINI_MODEL=""
# Optional. If the primary model above reports itself overloaded, this one
# is tried next — before ever falling through to Anthropic below — since a
# different Gemini model is a different capacity pool. Defaults to the
# smaller, auto-updating "gemini-flash-lite-latest". Set to the same value
# as GEMINI_MODEL (or leave both unset with a single pinned deployment) to
# skip this step entirely.
GEMINI_FALLBACK_MODEL=""

# Anthropic fallback. Used as the only provider when GEMINI_API_KEY is
# unset — but if BOTH are set, this is also used mid-scan whenever every
# configured Gemini model reports itself overloaded (common on the free
# tier under load), so a busy Gemini doesn't have to mean a failed scan.
# That's a real, if small (roughly a cent per scan on Claude Sonnet — see
# REQUIREMENTS.md's "AI shelf scan" section for the estimate), cost worth
# knowing about if you set both keys. Get a key at
# https://console.anthropic.com.
ANTHROPIC_API_KEY=""
# Optional. Overrides the vision model used for shelf scans. Defaults to a
# current Claude model with vision support if unset.
INVENTORY_SCAN_MODEL=""
