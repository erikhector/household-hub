{
  "name": "squirrel",
  "version": "0.129.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "node scripts/run-parallel.mjs lint typecheck test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:quick": "playwright test --project=desktop --project=mobile",
    "test:e2e:screenshots": "E2E_SCREENSHOT_DIR=${E2E_SCREENSHOT_DIR:-test-results/screenshots} playwright test smoke public",
    "test:e2e:audit": "E2E_AUDIT_DIR=${E2E_AUDIT_DIR:-test-results/audit} playwright test -c playwright.audit.config.ts",
    "ci:local": "npm run check && npm run build && npm run test:e2e",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.9.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/functions": "^3.9.9",
    "barcode-detector": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.41.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
